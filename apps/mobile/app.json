{
  "expo": {
    "name": "Meetiva",
    "slug": "Meetiva",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "meetiva",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.Meetiva",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Meetiva uses your microphone for one-to-one video calls.",
        "NSCameraUsageDescription": "Meetiva uses your camera for one-to-one video calls."
    }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Meetiva-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "android": {
      "package": "com.anonymous.Meetiva",
        "permissions": [
          "android.permission.CAMERA",
          "android.permission.RECORD_AUDIO"
        ]
    }
  }
}
